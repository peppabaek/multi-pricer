# Anthropic API Key for Term Sheet AI Extraction (Claude Opus 5)
# Set your real API key below or set it as a system environment variable:
# setx ANTHROPIC_API_KEY "sk-ant-..."
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Term Sheet 분석 프로바이더 -------------------------------------------
# 1차 모델. 무료로 쓰려면 gemini 또는 groq
# TERMSHEET_PROVIDER=gemini
# GEMINI_API_KEY=...        발급(카드 불필요): https://aistudio.google.com/apikey

# 2차 모델(교차검증). 1차와 다른 벤더여야 의미가 있습니다
# TERMSHEET_SECOND_PROVIDER=groq
# GROQ_API_KEY=...          발급(카드 불필요): https://console.groq.com/keys
