# Anthropic API Key for Term Sheet AI Extraction (Claude Opus 5)
# Set your real API key below or set it as a system environment variable:
# setx ANTHROPIC_API_KEY "sk-ant-..."
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Term Sheet 분석 프로바이더 -------------------------------------------
# 1차 모델
# TERMSHEET_PROVIDER=gemini
# GEMINI_API_KEY=AQ.Ab8RN6Jr1eAoFi_HZ6vCt41bFkkFtCph-gtA8ZgmZULPA60IOw       https://aistudio.google.com/apikey
# GEMINI_TIER=paid          유료 계정이면 paid (학습 미사용). 미지정 시 free 로 간주
# GEMINI_MODEL=gemini-2.0-flash

# 2차 모델(교차검증). 1차와 다른 벤더여야 의미가 있습니다
# TERMSHEET_SECOND_PROVIDER=anthropic
# TERMSHEET_SECOND_MODEL=claude-opus-5

# 무료로 돌리려면 (카드 불필요)
# TERMSHEET_SECOND_PROVIDER=groq
# GROQ_API_KEY=...          https://console.groq.com/keys
