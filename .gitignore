# ==========================================================================
# Secrets and credentials — never commit
# ==========================================================================
.env
.env.*
!.env.example

# LSEG / Refinitiv Workspace app key. This file holds a live production key and
# the organisation's product identity; it is configured per machine, not shared.
lseg_config.json
lseg_credentials.json
secrets.json
*credentials*.json
*_secret*
*.pem
*.key
*.pfx

# ==========================================================================
# Market data captures — large, and they contain live quote data
# ==========================================================================
pyeikon.*.log
pyeikon.*.log.*
*.log

# ==========================================================================
# Internal reference material
# Bank workbooks and counterparty documents. Kept out of version control by
# default; if the desk wants them versioned, use a private repo and drop these
# lines deliberately rather than by accident.
# ==========================================================================
reference/
*.xlsm
*.xlsb

# Real term sheets, if any are ever dropped in for testing.
# The synthetic samples under sample_termsheets/ are generated and safe.
termsheets_in/
*_REAL_*.pdf

# ==========================================================================
# One-off exploration scripts and dumps
# Kept local: ~190 files of throwaway diagnostics, several of which contain
# hardcoded RICs and at least one hardcoded app key.
# ==========================================================================
scratch/

# ==========================================================================
# Generated artefacts
# ==========================================================================
etc/*.png
dashboard*.png
*.tmp

